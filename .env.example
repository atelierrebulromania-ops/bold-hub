NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only BOCP configuration; leave unset until a dedicated invoices[GET],marketplace[GET] user and allowlisted egress IP exist.
BOCP_API_BASE_URL=
BOCP_API_USERNAME=
BOCP_API_PASSWORD=

# Server-only scheduled import. Keep disabled until 1 Oct 2026 and a BOCP-allowlisted fixed egress IP exist.
BOCP_AUTO_IMPORT_ENABLED=false
CRON_SECRET=
SUPABASE_SECRET_KEY=
