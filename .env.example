NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Server-only: creating/deleting logins, scheduled jobs and push dispatch.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only BOCP API (GET) and the B2B connector #6 (orders, proformas).
BOCP_API_BASE_URL=
BOCP_API_USERNAME=
BOCP_API_PASSWORD=
BOCP_B2B_CONNECTOR_ID=
BOCP_B2B_CONNECTOR_USERNAME=
BOCP_B2B_CONNECTOR_PASSWORD=

# Bearer secret for /api/cron/* and /api/push/dispatch (also stored in Supabase Vault as push_dispatch_secret).
CRON_SECRET=

# Browser push (generate with: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
